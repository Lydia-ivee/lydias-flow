{
  "name": "lydias-flow",
  "productName": "Lydia's Flow",
  "version": "0.1.0",
  "description": "Push-to-talk dictation for macOS that runs entirely on your Mac.",
  "license": "MIT",
  "author": "Lydia Miller",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/build-native.js && node scripts/download-engines.js && node scripts/download-models.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder --mac --arm64",
    "eval": "node evals/run.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "electron": "43.8.3",
    "electron-builder": "26.4.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
