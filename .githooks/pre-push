#!/usr/bin/env bash
# Runs automatically before every `git push` (enabled with:
#   git config core.hooksPath .githooks
# ). It blocks the push if the commits being pushed contain:
#   1. anything that looks like a secret (API key, token, password), via gitleaks
#   2. the name of my day-job company, which must never appear in this repo
#
# Git feeds this script one line per branch being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

ZERO=0000000000000000000000000000000000000000
# Written as a pattern so this file does not match itself.
BLOCKED_WORD='i[v]ee'
ALLOWED_USERNAME='[Ll]ydia-[Ii]vee'
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch, nothing to check

  if [ "$remote_sha" = "$ZERO" ]; then
    range=$local_sha # new branch: check its whole history
  else
    range="$remote_sha..$local_sha" # existing branch: only the new commits
  fi

  echo "pre-push: checking $range"

  # 1. Secrets
  if ! gitleaks git --no-banner --redact --log-opts="$range" >/dev/null 2>&1; then
    echo "pre-push: BLOCKED - gitleaks found a possible secret. Run:"
    echo "  gitleaks git --redact --log-opts=\"$range\""
    blocked=1
  fi

  # 2. Blocked word in commit authors, messages, or added lines
  # My GitHub username is the one allowed exception, so it is removed first.
  hits=$(git log -p --format='author: %an <%ae>%n%B' "$range" |
    grep -v '^-' | sed -E "s/$ALLOWED_USERNAME//g" | grep -inE "$BLOCKED_WORD" || true)
  if [ -n "$hits" ]; then
    echo "pre-push: BLOCKED - found a blocked word:"
    echo "$hits" | head -20
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi
echo "pre-push: clean"
