{
  // Type-checks the JavaScript (no TypeScript, no build step): `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/main/**/*.js", "src/shared/**/*.js", "scripts/**/*.js", "evals/**/*.js", "types/**/*.d.ts"]
}
